tolk 1.0

// Minimal DECLARATION file (plan §0.11) for the DeDust CPMM V2 claim_reward
// family. Structs + opcodes copied VERBATIM from the authoritative autogenerated
// source indexer/dedust_abis/cpmm_v2_abi.talk (fields, names, opcodes). Only the
// three messages the mch dedust_v2_claim_reward spec parses are declared here;
// the full 943-line contract is intentionally NOT compiled (would emit 60+
// structs into the production mch-classify lib for zero benefit). See
// ton-mch-engine/T122-CLAIMREWARD-DESIGN.md §2.

struct (0x909fdb65) ClaimRewardMessage {
    queryId: uint64;
    rewardIndex: uint2;
    excessesTo: address;
}

struct (0x9e17fbbe) PayoutRewardMessage {
    queryId: uint64;
    amount: coins;
    rewardIndex: uint2;
    ownerAddress: address;
    excessesTo: address;
}

struct (0x3216ca09) PayoutMessage {
    queryId: uint64;
    amount: coins;
    exitCode: int32;
    payload: cell?;
}

type AllowedMessage = ClaimRewardMessage | PayoutRewardMessage | PayoutMessage

struct Storage {
    dummy: uint1
}

contract DedustV2 {
    incomingMessages: AllowedMessage
    storage: Storage
}

fun onInternalMessage(in: InMessage) {
    val msg = lazy AllowedMessage.fromSlice(in.body);
    match (msg) {
        ClaimRewardMessage => {
            assert (msg.rewardIndex >= 0) throw 0xFFFF
        }
        PayoutRewardMessage => {
            assert (msg.amount >= 0) throw 0xFFFF
        }
        PayoutMessage => {
            assert (msg.exitCode >= 0) throw 0xFFFF
        }
        else => {
            assert (in.body.isEmpty()) throw 0xFFFF
        }
    }
}
