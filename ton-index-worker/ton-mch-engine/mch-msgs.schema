# mch-msgs.schema — declarative message-body parser schema (M1, program doc §3.2).
#
# The generator indexer/indexer/events/mch/msgs_gen.py compiles this file into a
# committed C++ TU (src/MsgParsersGenerated.cpp) of per-message body parsers that
# call ONLY the existing PSlice leaf helpers (load_coins_py / load_address_py /
# fetch_int256 / fetch_ref / the cell-slice cursor / vm::Dictionary) — zero new
# leaf semantics. Each parser reproduces its hand predecessor byte-for-byte; the
# parse-dump A/B twin gate is the correctness bar.
#
# ============================ GRAMMAR ============================
#
#   file      := (comment | message)*
#   comment   := '#' .*
#   message   := 'message' NAME 'opcode' HEX [policy] '{' field* '}'
#   policy    := 'skip-opcode'            # (default) skip the leading 32 bits
#   field     := NAME ':' type
#   type      := leaf | 'bits' N | 'ref' '{' field* '}'
#
# The leading 32 opcode bits are ALWAYS skipped unchecked (every hand parser
# advance(32)s without validating — soft-parse leniency). The HEX after `opcode`
# is documentation + vector filler only; it is never compared. A message with no
# query_id simply omits the field (e.g. DedustSwapNotification).
#
# LEAF TYPES (each maps 1:1 to an existing helper; emitted value in parens):
#   bits N         have(N) + advance(N)       -> (nothing emitted; a pure skip of
#                                                 N bits — always used with a `_`
#                                                 parsed-and-dropped field name)
#   bool           fetch_ulong(1) != 0        -> Bool. The EMITTING 1-bit leaf;
#                                                 `bits 1` is the skipping one.
#                                                 TWIN RULE: pytoniq's load_bit()
#                                                 returns an INT, so a bool field's
#                                                 Python twin must cast — an int
#                                                 where the C++ side has a Bool
#                                                 faults the expression VM the
#                                                 moment the field is used as a
#                                                 condition.
#   u32            fetch_ulong(32)            -> Int   (refint_u64)
#   u64            fetch_ulong(64)            -> Int   (refint_u64)
#   uint128        fetch_int256(128, false)   -> Int   (tonco liquidity / share widths)
#   uint256        fetch_int256(256, false)   -> Int
#   int24          fetch_int256(24, true)     -> Int, the only SIGNED leaf (tonco
#                                                 tick indices go negative). Its
#                                                 twin is pytoniq load_int(24),
#                                                 already a signed int, so unlike
#                                                 `bool` it needs no casting twin.
#   coins          load_coins_py              -> Int   (VarUInteger 16; len nibble 0 -> 0)
#   addr_py        load_address_py            -> Account | Null | "extern:.." Str
#   asset2         2-bit tag (coffee)         -> Asset  (0=TON, 1=jetton wc:HEX)
#   asset4         4-bit kind (dedust)        -> Asset  (0=TON, else jetton wc:HEX)
#   ref_cell       mandatory fetch_ref        -> Cell   (kept whole, not descended)
#   maybe_ref_cell Maybe ^Cell                -> Cell | Null; bit=1 requires the
#                                                 ref, bit=0 is Null. NO remainder
#                                                 fallback (unlike fwd_cell_*)
#   dict_keys267   HashmapE(267) key walk     -> List[Account]  (values ignored)
#   fwd_cell_bits  maybe-ref-or-remainder     -> Cell | Null; remainder taken when
#                                                 unconsumed BITS remain (JettonNotify)
#   fwd_cell_refs  maybe-ref-or-remainder     -> Cell | Null; remainder taken when
#                                                 unconsumed REFS remain (PTonTransfer)
#
# COMPOSITE:
#   ref { ... }    descend a mandatory ref into a fresh cursor; the subfields are
#                  FLATTENED into the parent object (the group name is not emitted).
#
# NOT GENERATED (kept hand — see Parsers.h / MsgParse.cpp):
#   JettonTransfer          forward-payload sum-type tail (hand continuation)
#   JettonBurnNotification  parse_never (Python class is not Slice-constructible)
#   MinterJettonMint        master_msg is both a Cell field AND a prefixed descend
#                           (single-use nested-capture construct — not in the DSL)
#   EvaaWithdrawFailExcess  opcode IS an enum (no skip) emitting opcode+reason
#                           (single-use enum construct — not in the DSL)
#   ChangeDnsRecordMessage / VestingSendMessage / LayerZeroOappExecuteCallback
#                           irreducible hand parsers (dns / int_msg_info / layerzero)
# ================================================================

message JettonInternalTransfer opcode 0x178d4519 {
  query_id: u64
  amount: coins
  from_address: addr_py
  response_address: addr_py
  forward_ton_amount: coins
}

message JettonBurn opcode 0x595f07bc {
  query_id: u64
  amount: coins
  response_destination: addr_py
}

message JettonNotify opcode 0x7362d09c {
  query_id: u64
  jetton_amount: coins
  from_user: addr_py
  forward_payload_cell: fwd_cell_bits
}

message JettonMint opcode 0x642b7d07 {
  query_id: u64
  to_address: addr_py
  ton_amount: coins
}

message PTonTransfer opcode 0x01f3835d {
  query_id: u64
  ton_amount: coins
  refund_address: addr_py
  forward_payload: fwd_cell_refs
}

message StonfiV2ProvideLiquidity opcode 0x37c096df {
  query_id: u64
  from_user: addr_py
  amount1: coins
  amount2: coins
}

message DedustPayoutFromPool opcode 0x474f86cf {
  query_id: u64
  proof: ref_cell
  amount: coins
}

message DedustSwapNotification opcode 0x9c610de3 {
  asset_in: asset4
  asset_out: asset4
  amount_in: coins
  amount_out: coins
  info: ref {
    sender_address: addr_py
    ref_address: addr_py
    reserve_0: coins
    reserve_1: coins
  }
}

message CoffeeCreateVault opcode 0x00000000 {
  query_id: u64
  asset: asset2
}

# --- specs/evaa.mch `evaa_supply`. Read ONLY by the C++ host fn
# evaa_supply_data (host/HostEvaa.cpp); the spec never `parse`s them, so unlike
# the tonco withdraw entries these have no Python twin — the Python host fn uses
# the legacy classes directly. Narrow on purpose, like
# ToncoRouterV3SwapSourceWallet: each stops after the last field the core reads.
#
# EvaaSupplyUser (0x11) is deliberately absent: the user contract prefixes its
# opcode with a variable-length header, and the schema always skips exactly 32
# bits, so it stays a hand walk (shared with the withdraw predicates).

# The TON-side anchor.
message EvaaSupplyMaster opcode 0x00000001 {
  _query_id: bits 64
  _include_user_code: bits 2
  supply_amount: u64
  recipient_address: addr_py
}

# Same 0x1 opcode as EvaaSupplyMaster but a different body: the jetton-side
# anchor's FORWARD PAYLOAD, which has no query_id. The conditional
# forward_amount / custom_response_payload tail is unread, so parsing stops.
message EvaaSupplyJettonForward opcode 0x00000001 {
  _include_user_code: bits 2
  recipient_address: addr_py
}

# Master -> user success report; the core takes the authoritative amount here.
message EvaaSupplySuccess opcode 0x0000011a {
  _query_id: bits 64
  _owner_address: addr_py
  _asset_id: uint256
  amount_supplied: u64
}

message EvaaWithdrawMaster opcode 0x00000002 {
  query_id: u64
  asset_id: uint256
  amount: u64
  recipient_address: addr_py
}

message EvaaWithdrawCollateralized opcode 0x00000211 {
  query_id: u64
  owner_address: addr_py
  asset_id: uint256
  withdraw_amount_current: u64
}

message JVaultUnstakeJettons opcode 0x499a9262 {
  query_id: u64
  jettons_to_unstake: coins
}

message JVaultUnstakeRequest opcode 0x0168d4b7 {
  query_id: u64
  jettons_to_unstake: coins
}

message JVaultClaim opcode 0x78d9f109 {
  query_id: u64
  jettons_to_claim: dict_keys267
}

# --- W3: host-embedded decoders (previously hand cursor-walks inside src/host/*).
# Hosts now call parse_message_body(<name>, body) and unpack the Obj into their
# existing typed struct (a thin shim); the per-fn error policy (rt_fault vs
# Null-reject vs pred-False) stays in the host caller, unchanged.

# HostCoffee coffee_swap peer event (opcode 0xc0ffee30). Fields: the swapped
# asset (2-bit tag) + in/out coins. query_id skipped.
message CoffeeSwapEvent opcode 0xc0ffee30 {
  _query_id: bits 64
  asset: asset2
  amount_in: coins
  amount_out: coins
}

# HostNft parse_ownership_prev_owner: the transfer core reads ONLY prev_owner.
message NftOwnershipAssignedPrevOwner opcode 0x05138d91 {
  _query_id: bits 64
  prev_owner: addr_py
}

# HostJvault jvault_stake_period: a transfer forward_payload; op skipped, then a
# 32-bit stake period. (Host decodes the b64 arg to a cell, then parse_message_body.)
message JVaultStakePeriodPayload opcode 0x00000000 {
  stake_period: u32
}

# HostStonfi parse_payment_request (StonfiPaymentRequest, opcode 0xf93bb43f). The
# v1 core reads exit_code + amount0/token0/amount1/token1 (in a ref). owner dropped.
message StonfiPaymentRequest opcode 0xf93bb43f {
  _query_id: bits 64
  _owner: addr_py
  exit_code: u32
  info: ref {
    amount0_out: coins
    token0: addr_py
    amount1_out: coins
    token1: addr_py
  }
}

# HostStonfi parse_swap_v1 (StonfiSwapMessage, opcode 0x25938561). Core reads
# from_user_address, token_wallet, amount, from_real_user (in a ref).
message StonfiSwapMessage opcode 0x25938561 {
  _query_id: bits 64
  from_user_address: addr_py
  token_wallet: addr_py
  amount: coins
  _min_out: coins
  _has_ref: bits 1
  info: ref {
    from_real_user: addr_py
  }
}

# HostStonfi parse_pay_to (StonfiV2PayTo, opcode 0x657b54f5). Core reads exit_code
# + amount0/token0/amount1/token1 (in additional_info ref). to/exc/orig + the
# custom_payload maybe-ref + fwd_ton are consumed-and-dropped.
message StonfiV2PayTo opcode 0x657b54f5 {
  _query_id: bits 64
  _to: addr_py
  _exc: addr_py
  _orig: addr_py
  exit_code: u32
  _cp: maybe_ref_cell
  info: ref {
    _fwd_ton: coins
    amount0_out: coins
    token0: addr_py
    amount1_out: coins
    token1: addr_py
  }
}

# HostDedustDeposit parse_pool_deposit (DedustDepositLiquidityToPool, opcode
# 0xb56b9598). Core reads owner + asset0/asset0_amount/asset1/asset1_amount (in
# field4 ref). proof ref + min_lp are dropped.
message DedustDepositLiquidityToPool opcode 0xb56b9598 {
  _query_id: bits 64
  _proof: ref_cell
  owner: addr_py
  _min_lp: coins
  field4: ref {
    asset0: asset4
    asset0_amount: coins
    asset1: asset4
    asset1_amount: coins
  }
}

# HostTonco parse_v3_swap_source_wallet (ToncoRouterV3Swap, opcode 0xa7fb58f8).
# Core reads ONLY source_wallet (owner dropped).
message ToncoRouterV3SwapSourceWallet opcode 0xa7fb58f8 {
  _query_id: bits 64
  _owner: addr_py
  source_wallet: addr_py
}

# --- specs/tonco_liquidity.mch `tonco_withdraw_liquidity` chain.
#
# All three reuse their LEGACY class as the Python twin unchanged (blocks/
# messages/liquidity.py), so each entry below covers the WHOLE body even where
# the spec reads one field: a `_`-dropped tail still advances the cursor, which
# keeps accept/reject identical to the twin on a truncated body. These are the
# first users of the uint128 and int24 leaves.
#
# ToncoRouterV3PayTo (0xa1daa96d) is deliberately absent — its coinsinfo is a
# Maybe ^Cell (no `maybe_ref { }` composite exists) and its tail refs are
# conditional on exit_code, so it stays with the host fn, like the tonco swap.

# Anchor. The spec reads every field but query_id.
message ToncoPoolV3StartBurn opcode 0x530b5f2c {
  _query_id: bits 64
  burned_index: u64
  liquidity_to_burn: uint128
  tick_lower: int24
  tick_upper: int24
}

# Pool -> position NFT. The spec reads ONLY nft_owner (the withdrawer).
message ToncoPositionNftV3PositionBurn opcode 0x46ca335a {
  _query_id: bits 64
  nft_owner: addr_py
  _liquidity_to_burn: uint128
  _tick_lower: int24
  _tick_upper: int24
  _old_fee: ref {
    _fee_growth_inside0_last_x128: uint256
    _fee_growth_inside1_last_x128: uint256
  }
}

# Position NFT -> pool. The spec reads ONLY burned_index, which overrides the
# anchor's when non-zero.
message ToncoPoolV3Burn opcode 0xd73ac09d {
  _query_id: bits 64
  _recipient: addr_py
  burned_index: u64
  _liquidity: uint128
  _tick_lower: int24
  _tick_upper: int24
  _liquidity_to_burn: uint128
  _old_fee: ref {
    _fee_growth_inside_0_last_x128: uint256
    _fee_growth_inside_1_last_x128: uint256
  }
  _new_fee: ref {
    _fee_growth_inside_0_current_x128: uint256
    _fee_growth_inside_1_current_x128: uint256
  }
}

# --- specs_decl/dedust_v2_swap.mch carriers and log.

# The TON-side swap carrier. The spec reads `amount` (the failed-swap in-leg
# amount) and hands `payment_payload` — the ref holding the swap payload — to
# the dedust_v2_swap_payload host fn. The trailing payout_config ref is left
# unparsed (the cursor simply stops).
message DedustV2PayNative opcode 0xa5a7cbf8 {
  _query_id: bits 64
  amount: coins
  payment_payload: ref_cell
}

# The pool's ext-out swap log: the only exact source of the per-hop amounts.
# x_to_y is dropped and the trailing state/fee refs are left unparsed.
message DedustV2SwapEvent opcode 0x78e79ba4 {
  _x_to_y: bits 1
  amount_in: coins
  amount_out: coins
}

# --- specs/teleitem_auction.mch anchor body.

# TeleitemStartAuction (opcode 0x487a8e81). The auction config lives in a
# mandatory ref; the spec reads beneficiary_address / initial_min_bid / max_bid.
# The three trailing config fields are parsed-and-dropped so the cursor still
# validates the full wire shape. DEVIATION (documented in the .mch header): the
# Python parser wraps the config read in try/except and falls back to
# beneficiary=None + zero bids, while a truncated ref rejects the match here.
message TeleitemStartAuction opcode 0x487a8e81 {
  _query_id: bits 64
  config: ref {
    beneficiary_address: addr_py
    initial_min_bid: coins
    max_bid: coins
    _min_bid_step: bits 8
    _min_extend_time: bits 32
    _duration: bits 32
  }
}

# --- specs/coffee_liquidity.mch + specs/coffee_withdraw.mch bodies.

# The deposit anchor (opcode 0xc0ffee27). The spec reads `amount`, the two POOL
# assets and `sender`. PoolParams lives in a mandatory ref whose subfields
# FLATTEN into the parent, so the two asset leaves are named `pool_first` /
# `pool_second` here and the Python twin (mch/builders/coffee.py) mirrors those
# names exactly. DepositLiquidityParamsTrimmed and the proof ref are
# parsed-and-dropped so the cursor still validates the full wire shape.
message CoffeeCreateLiquidityDepositoryRequest opcode 0xc0ffee27 {
  _query_id: bits 64
  amount: coins
  _params: ref {
    _recipient: addr_py
    _use_recipient_on_failure: bits 1
  }
  pool_params: ref {
    pool_first: asset2
    pool_second: asset2
    _amm: bits 3
    _amm_settings: maybe_ref_cell
  }
  sender: addr_py
  _proof: ref_cell
}

# The depository's success log (opcode 0xc0ffee33). The spec reads only
# `lp_amount`; the two inline PoolReserves pairs are parsed-and-dropped.
message CoffeeDepositLiquiditySuccessfulEvent opcode 0xc0ffee33 {
  _query_id: bits 64
  _amount1: coins
  _amount2: coins
  lp_amount: coins
  _total_supply_in: coins
  _total_supply_out: coins
  _reserves_in: coins
  _reserves_out: coins
}

# The pool's withdrawal log (opcode 0xc0ffee35). The spec reads the two payout
# amounts; lp_amount and the two inline PoolReserves pairs are dropped.
message CoffeeLiquidityWithdrawalEvent opcode 0xc0ffee35 {
  _query_id: bits 64
  amount1: coins
  amount2: coins
  _lp_amount: coins
  _total_supply_in: coins
  _total_supply_out: coins
  _reserves_in: coins
  _reserves_out: coins
}

# --- specs/nft_sale.mch bodies.

# UpdateSaleMatcher's anchor (messages/getgems.py SaleUpdateMessage). Field name
# `new_mp_fee` is the message's, not the block data's (`new_marketplace_fee`);
# the .mch out{} does the rename, same as the legacy build.
message SaleUpdateMessage opcode 0x6c6c2080 {
  _query_id: bits 64
  new_full_price: coins
  new_mp_fee: coins
  new_royalty_amount: coins
}

# NftDiscoveryBlockMatcher's mandatory child (messages/nft.py
# NftReportStaticData). Every field of the produced block comes from HERE, not
# from the discovery anchor — including its query_id.
message NftReportStaticData opcode 0x8b771735 {
  query_id: u64
  index: uint256
  collection: addr_py
}

# --- specs/dedust_v2_claim_fees.mch body.

# The ONE body the LP fees claim parses (messages/dedust_v2.py
# DedustV2PayoutPositionFees): the exact accrued x/y fees + the LP owner. The
# trailing excesses_to address is not read, so the parser stops at `owner`. The
# other three opcodes in the chain are matched by `op` only.
message DedustV2PayoutPositionFees opcode 0x29ff1bcf {
  query_id: u64
  x_fees: coins
  y_fees: coins
  owner: addr_py
}

# --- specs/tonstakers.mch bodies.

# The tonstakers family's ONLY message with a real body (messages/staking.py
# TONStakersNftBurnNotification). Anchor of the delayed withdrawal's payout leg:
# every field of the produced block that is not a message envelope comes from
# here. The other eight TONStakers* opcodes are bare markers and are never
# parsed.
message TONStakersNftBurnNotification opcode 0xed58b0b2 {
  query_id: u64
  amount: coins
  owner: addr_py
}

# --- specs/dedust_v2_withdraw.mch bodies.
#
# Both twins are the LEGACY classes (messages/dedust_v2.py DedustV2Withdraw /
# DedustV2WithdrawalEvent), the DedustV2PayoutPositionFees arrangement — so
# unlike the two entries above these parse the message to its END rather than
# stopping at the last field the spec reads. Parsing the full wire shape is what
# makes the two sides fail on exactly the same truncations; the unread fields
# carry `_` and are dropped. The other two opcodes of the chain
# (WithdrawLiquidity 0xbc1531a9, ExitLiquidity 0xf6f6a3aa) are matched by `op`
# only and have no entry.

# user -> Pool, the withdrawal entry. `liquidity` is the LP SHARE being burned
# (the share lives in the Position contract, there is no LP jetton) and is the
# fallback lp_tokens_burnt when the trace carries no Withdrawal event.
# auto_claim_fees is the FIRST use of the `bool` leaf: it mixes fee payouts into
# the same pool tx, which the payout slots cannot tell from withdrawn amounts,
# so the spec rejects on it.
message DedustV2Withdraw opcode 0x20b5ef89 {
  _query_id: bits 64
  liquidity: coins
  _minimal_x_out: coins
  _minimal_y_out: coins
  auto_claim_fees: bool
  _payout_config: ref_cell
}

# Pool -> ext-out log of a SUCCESSFUL withdrawal. Its mere presence is the
# success discriminator (the spec matches it `maybe`); the spec reads only
# `liquidity`, the exact burned share.
message DedustV2WithdrawalEvent opcode 0xc0d77b54 {
  liquidity: coins
  _amount_x_out: coins
  _amount_y_out: coins
  _initiator: addr_py
  _recipient: addr_py
  _next_state: ref_cell
}

# --- specs/coffee_create_pool.mch bodies.

# The pool-creator request (opcode 0xc0ffee23), the create_pool_creator anchor.
# `params:PoolParams` is INLINE here (unlike the depository request's ref), so
# its two assets are read straight off the cursor and named `pool_first` /
# `pool_second` to match that sibling's spelling. `creation_params` IS a ref;
# only the recipient of its public half is read, but the whole
# PublicPoolCreationParams + PrivatePoolCreationParams pair is walked so the ref
# cursor validates the same wire shape both hosts see.
#
# The legacy class of this name (messages/coffee.py:713) parses creation_params
# INLINE and therefore throws on a real body; nothing calls it, so the bug is
# invisible in production. mch/builders/coffee.py carries the correct flat twin.
message CoffeeCreatePoolCreatorRequest opcode 0xc0ffee23 {
  _query_id: bits 64
  amount: coins
  pool_first: asset2
  pool_second: asset2
  _amm: bits 3
  _amm_settings: maybe_ref_cell
  creation_params: ref {
    recipient: addr_py
    _use_recipient_on_failure: bits 1
    _notification_data: maybe_ref_cell
    _is_active: bits 1
    _extra_settings: maybe_ref_cell
  }
  sender: addr_py
  _proof: ref_cell
}

# The creator's ask to the factory (opcode 0xc0ffee25), fired once BOTH legs
# have landed: the two realized amounts in the pool's own asset order plus the
# initiator of the leg that completed the pair. Stops after tx_initiator — the
# creation_params ref and the proof ref are unread.
message CoffeeCreatePoolRequest opcode 0xc0ffee25 {
  _query_id: bits 64
  amount1: coins
  amount2: coins
  tx_initiator: addr_py
}

# --- specs/coffee_staking.mch bodies.

# The pool's reward payout order (opcode 0xb30c7310), the claim_rewards anchor.
# The trailing `payload:(Maybe ^CoffeeStakingForwardData)` is unread and left
# unparsed.
message CoffeeStakingClaimRewards opcode 0xb30c7310 {
  _query_id: bits 64
  jetton_wallet: addr_py
  jetton_amount: coins
  receiver: addr_py
}

# staking_position_withdraw_2, position -> master. THREE message types share the
# opcode 0xcb03bfaf (withdraw_1/2/3); the registry keys on the NAME, and the hex
# after `opcode` is documentation only — so all three may carry it. Only 2 and 3
# have an entry: withdraw_1's body is never read.
#
# Stops after `points`: the mandatory `jetton_data` ref that follows carries the
# same wallet/amount pair withdraw_3 states again, and the legacy build reads
# them from withdraw_3.
message CoffeeStakingPositionWithdraw2 opcode 0xcb03bfaf {
  _query_id: bits 64
  nft_id: u64
  owner: addr_py
  points: coins
}

# staking_position_withdraw_3, master -> jetton wallet: the payout instruction.
# `owner` trails and is unread.
message CoffeeStakingPositionWithdraw3 opcode 0xcb03bfaf {
  _query_id: bits 64
  jetton_wallet: addr_py
  jetton_amount: coins
}

# --- specs/dedust_v2_deposit.mch bodies.
#
# Like the withdraw trio above, these parse to the END of the wire shape so both
# sides fail on exactly the same truncations. The fourth opcode of the family
# (CreditLiquidity 0x855afcbd) is matched by `op` only and has no entry — the
# reference never parses it either. The DEPOSIT PAYLOAD (0xc9a015da, the desired
# amount_x/amount_y) is deliberately absent: it sits behind a ref on the TON
# carrier and inside a b64 forward payload on the jetton carrier, and it is only
# ours when its own opcode matches — a conditional descent the schema cannot
# express, so it goes through the dedust_v2_deposit_payload host fn instead.

# Pool -> Deposit escrow, one per credited asset leg. `is_x` (the second `bool`
# leaf user) says whether the leg is pool asset X or Y, which is what picks the
# 1/2 slot the leg's asset and wallet are written into.
message DedustV2CreditAsset opcode 0xdc5ddba1 {
  _query_id: bits 64
  is_x: bool
  amount: coins
}

# Deposit escrow -> Pool, fired once both legs are credited: the completion
# anchor. `amount_x`/`amount_y` are the ATTEMPTED amounts, used only when the
# join is rejected (no Deposit event, so no realized amounts exist).
message DedustV2JoinLiquidity opcode 0x25251ee0 {
  _query_id: bits 64
  _config: ref_cell
  amount_x: coins
  amount_y: coins
  initiator: addr_py
}

# Pool -> ext-out log of a SUCCESSFUL deposit. Presence is the success
# discriminator; it is also the only exact source of the consumed amounts and of
# the minted LP.
message DedustV2DepositEvent opcode 0x35df2e12 {
  amount_x_in: coins
  amount_y_in: coins
  liquidity: coins
  _initiator: addr_py
  _recipient: addr_py
  _next_state: ref_cell
}
