# mch-msgs.schema — declarative message-body parser schema (M1, program doc §3.2).
#
# The generator indexer/indexer/events/mch/msgs_gen.py compiles this file into a
# committed C++ TU (src/MsgParsersGenerated.cpp) of per-message body parsers that
# call ONLY the existing PSlice leaf helpers (load_coins_py / load_address_py /
# fetch_int256 / fetch_ref / the cell-slice cursor / vm::Dictionary) — zero new
# leaf semantics. Each parser reproduces its hand predecessor byte-for-byte; the
# parse-dump A/B twin gate is the correctness bar.
#
# ============================ GRAMMAR ============================
#
#   file      := (comment | message)*
#   comment   := '#' .*
#   message   := 'message' NAME 'opcode' HEX [policy] '{' field* '}'
#   policy    := 'skip-opcode'            # (default) skip the leading 32 bits
#   field     := NAME ':' type
#   type      := leaf | 'bits' N | 'ref' '{' field* '}'
#
# The leading 32 opcode bits are ALWAYS skipped unchecked (every hand parser
# advance(32)s without validating — soft-parse leniency). The HEX after `opcode`
# is documentation + vector filler only; it is never compared. A message with no
# query_id simply omits the field (e.g. DedustSwapNotification).
#
# LEAF TYPES (each maps 1:1 to an existing helper; emitted value in parens):
#   bits N         have(N) + advance(N)       -> (nothing emitted; a pure skip of
#                                                 N bits — always used with a `_`
#                                                 parsed-and-dropped field name)
#   u32            fetch_ulong(32)            -> Int   (refint_u64)
#   u64            fetch_ulong(64)            -> Int   (refint_u64)
#   uint256        fetch_int256(256, false)   -> Int
#   coins          load_coins_py              -> Int   (VarUInteger 16; len nibble 0 -> 0)
#   addr_py        load_address_py            -> Account | Null | "extern:.." Str
#   asset2         2-bit tag (coffee)         -> Asset  (0=TON, 1=jetton wc:HEX)
#   asset4         4-bit kind (dedust)        -> Asset  (0=TON, else jetton wc:HEX)
#   ref_cell       mandatory fetch_ref        -> Cell   (kept whole, not descended)
#   maybe_ref_cell Maybe ^Cell                -> Cell | Null; bit=1 requires the
#                                                 ref, bit=0 is Null. NO remainder
#                                                 fallback (unlike fwd_cell_*)
#   dict_keys267   HashmapE(267) key walk     -> List[Account]  (values ignored)
#   fwd_cell_bits  maybe-ref-or-remainder     -> Cell | Null; remainder taken when
#                                                 unconsumed BITS remain (JettonNotify)
#   fwd_cell_refs  maybe-ref-or-remainder     -> Cell | Null; remainder taken when
#                                                 unconsumed REFS remain (PTonTransfer)
#
# COMPOSITE:
#   ref { ... }    descend a mandatory ref into a fresh cursor; the subfields are
#                  FLATTENED into the parent object (the group name is not emitted).
#
# NOT GENERATED (kept hand — see Parsers.h / MsgParse.cpp):
#   JettonTransfer          forward-payload sum-type tail (hand continuation)
#   JettonBurnNotification  parse_never (Python class is not Slice-constructible)
#   MinterJettonMint        master_msg is both a Cell field AND a prefixed descend
#                           (single-use nested-capture construct — not in the DSL)
#   EvaaWithdrawFailExcess  opcode IS an enum (no skip) emitting opcode+reason
#                           (single-use enum construct — not in the DSL)
#   ChangeDnsRecordMessage / VestingSendMessage / LayerZeroOappExecuteCallback
#                           irreducible hand parsers (dns / int_msg_info / layerzero)
# ================================================================

message JettonInternalTransfer opcode 0x178d4519 {
  query_id: u64
  amount: coins
  from_address: addr_py
  response_address: addr_py
  forward_ton_amount: coins
}

message JettonBurn opcode 0x595f07bc {
  query_id: u64
  amount: coins
  response_destination: addr_py
}

message JettonNotify opcode 0x7362d09c {
  query_id: u64
  jetton_amount: coins
  from_user: addr_py
  forward_payload_cell: fwd_cell_bits
}

message JettonMint opcode 0x642b7d07 {
  query_id: u64
  to_address: addr_py
  ton_amount: coins
}

message PTonTransfer opcode 0x01f3835d {
  query_id: u64
  ton_amount: coins
  refund_address: addr_py
  forward_payload: fwd_cell_refs
}

message StonfiV2ProvideLiquidity opcode 0x37c096df {
  query_id: u64
  from_user: addr_py
  amount1: coins
  amount2: coins
}

message DedustPayoutFromPool opcode 0x474f86cf {
  query_id: u64
  proof: ref_cell
  amount: coins
}

message DedustSwapNotification opcode 0x9c610de3 {
  asset_in: asset4
  asset_out: asset4
  amount_in: coins
  amount_out: coins
  info: ref {
    sender_address: addr_py
    ref_address: addr_py
    reserve_0: coins
    reserve_1: coins
  }
}

message CoffeeCreateVault opcode 0x00000000 {
  query_id: u64
  asset: asset2
}

message EvaaWithdrawMaster opcode 0x00000002 {
  query_id: u64
  asset_id: uint256
  amount: u64
  recipient_address: addr_py
}

message EvaaWithdrawCollateralized opcode 0x00000211 {
  query_id: u64
  owner_address: addr_py
  asset_id: uint256
  withdraw_amount_current: u64
}

message JVaultUnstakeJettons opcode 0x499a9262 {
  query_id: u64
  jettons_to_unstake: coins
}

message JVaultUnstakeRequest opcode 0x0168d4b7 {
  query_id: u64
  jettons_to_unstake: coins
}

message JVaultClaim opcode 0x78d9f109 {
  query_id: u64
  jettons_to_claim: dict_keys267
}

# --- W3: host-embedded decoders (previously hand cursor-walks inside src/host/*).
# Hosts now call parse_message_body(<name>, body) and unpack the Obj into their
# existing typed struct (a thin shim); the per-fn error policy (rt_fault vs
# Null-reject vs pred-False) stays in the host caller, unchanged.

# HostCoffee coffee_swap peer event (opcode 0xc0ffee30). Fields: the swapped
# asset (2-bit tag) + in/out coins. query_id skipped.
message CoffeeSwapEvent opcode 0xc0ffee30 {
  _query_id: bits 64
  asset: asset2
  amount_in: coins
  amount_out: coins
}

# HostNft parse_ownership_prev_owner: the transfer core reads ONLY prev_owner.
message NftOwnershipAssignedPrevOwner opcode 0x05138d91 {
  _query_id: bits 64
  prev_owner: addr_py
}

# HostJvault jvault_stake_period: a transfer forward_payload; op skipped, then a
# 32-bit stake period. (Host decodes the b64 arg to a cell, then parse_message_body.)
message JVaultStakePeriodPayload opcode 0x00000000 {
  stake_period: u32
}

# HostStonfi parse_payment_request (StonfiPaymentRequest, opcode 0xf93bb43f). The
# v1 core reads exit_code + amount0/token0/amount1/token1 (in a ref). owner dropped.
message StonfiPaymentRequest opcode 0xf93bb43f {
  _query_id: bits 64
  _owner: addr_py
  exit_code: u32
  info: ref {
    amount0_out: coins
    token0: addr_py
    amount1_out: coins
    token1: addr_py
  }
}

# HostStonfi parse_swap_v1 (StonfiSwapMessage, opcode 0x25938561). Core reads
# from_user_address, token_wallet, amount, from_real_user (in a ref).
message StonfiSwapMessage opcode 0x25938561 {
  _query_id: bits 64
  from_user_address: addr_py
  token_wallet: addr_py
  amount: coins
  _min_out: coins
  _has_ref: bits 1
  info: ref {
    from_real_user: addr_py
  }
}

# HostStonfi parse_pay_to (StonfiV2PayTo, opcode 0x657b54f5). Core reads exit_code
# + amount0/token0/amount1/token1 (in additional_info ref). to/exc/orig + the
# custom_payload maybe-ref + fwd_ton are consumed-and-dropped.
message StonfiV2PayTo opcode 0x657b54f5 {
  _query_id: bits 64
  _to: addr_py
  _exc: addr_py
  _orig: addr_py
  exit_code: u32
  _cp: maybe_ref_cell
  info: ref {
    _fwd_ton: coins
    amount0_out: coins
    token0: addr_py
    amount1_out: coins
    token1: addr_py
  }
}

# HostDedustDeposit parse_pool_deposit (DedustDepositLiquidityToPool, opcode
# 0xb56b9598). Core reads owner + asset0/asset0_amount/asset1/asset1_amount (in
# field4 ref). proof ref + min_lp are dropped.
message DedustDepositLiquidityToPool opcode 0xb56b9598 {
  _query_id: bits 64
  _proof: ref_cell
  owner: addr_py
  _min_lp: coins
  field4: ref {
    asset0: asset4
    asset0_amount: coins
    asset1: asset4
    asset1_amount: coins
  }
}

# HostTonco parse_v3_swap_source_wallet (ToncoRouterV3Swap, opcode 0xa7fb58f8).
# Core reads ONLY source_wallet (owner dropped).
message ToncoRouterV3SwapSourceWallet opcode 0xa7fb58f8 {
  _query_id: bits 64
  _owner: addr_py
  source_wallet: addr_py
}

# --- specs_decl/dedust_v2_swap.mch carriers and log.

# The TON-side swap carrier. The spec reads `amount` (the failed-swap in-leg
# amount) and hands `payment_payload` — the ref holding the swap payload — to
# the dedust_v2_swap_payload host fn. The trailing payout_config ref is left
# unparsed (the cursor simply stops).
message DedustV2PayNative opcode 0xa5a7cbf8 {
  _query_id: bits 64
  amount: coins
  payment_payload: ref_cell
}

# The pool's ext-out swap log: the only exact source of the per-hop amounts.
# x_to_y is dropped and the trailing state/fee refs are left unparsed.
message DedustV2SwapEvent opcode 0x78e79ba4 {
  _x_to_y: bits 1
  amount_in: coins
  amount_out: coins
}

# --- specs/teleitem_auction.mch anchor body.

# TeleitemStartAuction (opcode 0x487a8e81). The auction config lives in a
# mandatory ref; the spec reads beneficiary_address / initial_min_bid / max_bid.
# The three trailing config fields are parsed-and-dropped so the cursor still
# validates the full wire shape. DEVIATION (documented in the .mch header): the
# Python parser wraps the config read in try/except and falls back to
# beneficiary=None + zero bids, while a truncated ref rejects the match here.
message TeleitemStartAuction opcode 0x487a8e81 {
  _query_id: bits 64
  config: ref {
    beneficiary_address: addr_py
    initial_min_bid: coins
    max_bid: coins
    _min_bid_step: bits 8
    _min_extend_time: bits 32
    _duration: bits 32
  }
}

# --- specs/coffee_liquidity.mch + specs/coffee_withdraw.mch bodies.

# The deposit anchor (opcode 0xc0ffee27). The spec reads `amount`, the two POOL
# assets and `sender`. PoolParams lives in a mandatory ref whose subfields
# FLATTEN into the parent, so the two asset leaves are named `pool_first` /
# `pool_second` here and the Python twin (mch/builders/coffee.py) mirrors those
# names exactly. DepositLiquidityParamsTrimmed and the proof ref are
# parsed-and-dropped so the cursor still validates the full wire shape.
message CoffeeCreateLiquidityDepositoryRequest opcode 0xc0ffee27 {
  _query_id: bits 64
  amount: coins
  _params: ref {
    _recipient: addr_py
    _use_recipient_on_failure: bits 1
  }
  pool_params: ref {
    pool_first: asset2
    pool_second: asset2
    _amm: bits 3
    _amm_settings: maybe_ref_cell
  }
  sender: addr_py
  _proof: ref_cell
}

# The depository's success log (opcode 0xc0ffee33). The spec reads only
# `lp_amount`; the two inline PoolReserves pairs are parsed-and-dropped.
message CoffeeDepositLiquiditySuccessfulEvent opcode 0xc0ffee33 {
  _query_id: bits 64
  _amount1: coins
  _amount2: coins
  lp_amount: coins
  _total_supply_in: coins
  _total_supply_out: coins
  _reserves_in: coins
  _reserves_out: coins
}

# The pool's withdrawal log (opcode 0xc0ffee35). The spec reads the two payout
# amounts; lp_amount and the two inline PoolReserves pairs are dropped.
message CoffeeLiquidityWithdrawalEvent opcode 0xc0ffee35 {
  _query_id: bits 64
  amount1: coins
  amount2: coins
  _lp_amount: coins
  _total_supply_in: coins
  _total_supply_out: coins
  _reserves_in: coins
  _reserves_out: coins
}

# --- specs/nft_sale.mch bodies.

# UpdateSaleMatcher's anchor (messages/getgems.py SaleUpdateMessage). Field name
# `new_mp_fee` is the message's, not the block data's (`new_marketplace_fee`);
# the .mch out{} does the rename, same as the legacy build.
message SaleUpdateMessage opcode 0x6c6c2080 {
  _query_id: bits 64
  new_full_price: coins
  new_mp_fee: coins
  new_royalty_amount: coins
}

# NftDiscoveryBlockMatcher's mandatory child (messages/nft.py
# NftReportStaticData). Every field of the produced block comes from HERE, not
# from the discovery anchor — including its query_id.
message NftReportStaticData opcode 0x8b771735 {
  query_id: u64
  index: uint256
  collection: addr_py
}

# --- specs/dedust_v2_claim_fees.mch body.

# The ONE body the LP fees claim parses (messages/dedust_v2.py
# DedustV2PayoutPositionFees): the exact accrued x/y fees + the LP owner. The
# trailing excesses_to address is not read, so the parser stops at `owner`. The
# other three opcodes in the chain are matched by `op` only.
message DedustV2PayoutPositionFees opcode 0x29ff1bcf {
  query_id: u64
  x_fees: coins
  y_fees: coins
  owner: addr_py
}

# --- specs/tonstakers.mch bodies.

# The tonstakers family's ONLY message with a real body (messages/staking.py
# TONStakersNftBurnNotification). Anchor of the delayed withdrawal's payout leg:
# every field of the produced block that is not a message envelope comes from
# here. The other eight TONStakers* opcodes are bare markers and are never
# parsed.
message TONStakersNftBurnNotification opcode 0xed58b0b2 {
  query_id: u64
  amount: coins
  owner: addr_py
}
